{
  "name": "pitlane-windows",
  "productName": "PITLANE",
  "version": "1.0.0",
  "private": true,
  "description": "PITLANE desktop app for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "ly.pitlane.desktop",
    "productName": "PITLANE",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PITLANE"
    }
  }
}
